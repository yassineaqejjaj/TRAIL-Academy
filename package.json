{
  "name": "trail-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "e2e": "playwright test",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.mts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/migrate.mts --seed",
    "db:dev": "tsx scripts/dev-db.mts",
    "admin:create": "tsx --env-file-if-exists=.env.local scripts/create-admin.mts",
    "gateway": "node services/stream-gateway/src/server.ts",
    "screenshots": "tsx --env-file-if-exists=.env.local scripts/capture-screenshots.mts",
    "storage:setup": "tsx scripts/setup-storage.mts",
    "check:env": "tsx scripts/check-env.mts",
    "demo": "tsx --env-file-if-exists=.env.local scripts/demo.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-presigned-post": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "^1.7.12",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}

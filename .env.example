# Copy to .env.local (never commit real values). The public site runs without any of this; features degrade honestly.

# ── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# ── PostgreSQL (Railway plugin, Docker, or `npm run db:dev`) ─────────
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# "require" for Railway's public proxy URL (self-signed certificate). Prefer the private network URL when co-located.
DATABASE_SSL=
DATABASE_POOL_MAX=4
DATABASE_AUTH_POOL_MAX=2
# ONLY for the embedded dev database (`npm run db:dev`, PGlite has a single backend). Never against a real server.
DATABASE_SINGLE_CONNECTION=

# ── Authentication (Better Auth) ─────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Defaults to NEXT_PUBLIC_SITE_URL
BETTER_AUTH_URL=
# Auth endpoint rate limiting is ON in production. "off" is for local end-to-end runs only; "on" forces it in development.
AUTH_RATE_LIMIT=
# Per-IP limit of auth form submissions per 10 minutes (in-memory second line of defence; default 20)
AUTH_ACTION_LIMIT=
# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── E-mail over SMTP (nodemailer): any provider or relay ─────────────
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="TRAIL Academy <no-reply@example.com>"
LEADS_TO_EMAIL=
# "console" prints e-mails to the server log instead of sending (local development only)
EMAIL_TRANSPORT=

# ── Object storage (S3 API: MinIO on Railway) ────────────────────────
S3_ENDPOINT=http://127.0.0.1:9000
# Browser-reachable endpoint used in presigned URLs when S3_ENDPOINT is a private address
S3_PUBLIC_ENDPOINT=
S3_BUCKET=trail
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Video: self-hosted HLS behind the stream gateway ─────────────────
STREAM_GATEWAY_URL=http://127.0.0.1:8080
# Generate with: openssl rand -base64 48 — shared with the gateway
STREAM_SIGNING_SECRET=

# ── Payments: Stripe, TEST MODE only until legal review is complete ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Live keys are refused unless BOTH flags are "true" (never set before legal review)
ALLOW_LIVE_PAYMENTS=false
LEGAL_REVIEW_COMPLETED=false
# "true" once Stripe Tax is configured in the Stripe dashboard (no tax rate is hard-coded)
STRIPE_AUTOMATIC_TAX=false

# ── Jobs ─────────────────────────────────────────────────────────────
# Bearer secret for /api/cron/expire (Vercel Cron sends it automatically when CRON_SECRET is set)
CRON_SECRET=

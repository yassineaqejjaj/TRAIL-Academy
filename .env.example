# Copy to .env.local. Never commit real values.

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — TEST MODE keys only until legal review is complete (Phase C)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend) — used by the enterprise quote form
RESEND_API_KEY=
EMAIL_FROM=
LEADS_TO_EMAIL=

# Video provider (Phase B): mux | cloudflare_stream
VIDEO_PROVIDER=

# Mux signed playback (Phase B) — base64-encoded PEM private key
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# Commerce (Phase C)
# Stripe test mode only. Live keys are refused unless BOTH flags below are "true" (never set before legal review).
ALLOW_LIVE_PAYMENTS=false
LEGAL_REVIEW_COMPLETED=false
# "true" once Stripe Tax is configured in the Stripe dashboard (tax rates are never hard-coded)
STRIPE_AUTOMATIC_TAX=false
# Bearer secret for /api/cron/expire (Vercel cron)
CRON_SECRET=
